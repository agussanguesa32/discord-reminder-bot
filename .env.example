# ── Discord Bot ────────────────────────────────────────────────────────────────
DISCORD_TOKEN=your_discord_bot_token_here

# ── Discord OAuth2 ─────────────────────────────────────────────────────────────
# Create an app at https://discord.com/developers/applications
DISCORD_CLIENT_ID=your_discord_app_client_id
DISCORD_CLIENT_SECRET=your_discord_app_client_secret

# Must match exactly the redirect URI set in the Discord developer portal
DISCORD_REDIRECT_URI=http://localhost:8000/auth/callback

# ── Security ───────────────────────────────────────────────────────────────────
# Generate a random secret: openssl rand -hex 32
JWT_SECRET=your_random_jwt_secret_here

# ── URLs ───────────────────────────────────────────────────────────────────────
# Public API URL used by the browser for the Discord login redirect
NEXT_PUBLIC_API_URL=http://localhost:8000

# Public frontend URL — the API redirects here after OAuth completes
FRONTEND_URL=http://localhost:3000
